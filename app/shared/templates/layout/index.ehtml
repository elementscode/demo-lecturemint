import "./style.css";
import { redirect, session } from "@elements/app";
import { signout } from "#app/shared/services/auth";
import favicon from "#app/shared/assets/favicons/favicon.svg";

function onSignout() {
  signout();
  redirect("/");
}

<Layout (title: string, active: string = "")>
  <head>
    <title>{title ? `${title} · lecturemint` : "lecturemint"}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <div class="app">
      <header class="site-header">
        <div class="site-header-inner row">
          <a class="site-brand row" href="/">
            <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
              <path d="M16 3c5 6 9 10.5 9 15.5A9 9 0 0 1 7 18.5C7 13.5 11 9 16 3Z" fill="var(--brand-300)" opacity="0.75"/>
              <path d="M16 9c3 4 5.5 7 5.5 10A5.5 5.5 0 0 1 10.5 19c0-3 2.5-6 5.5-10Z" fill="var(--accent)" opacity="0.85"/>
            </svg>
            <b>lecture<span>mint</span></b>
          </a>

          <nav class="site-nav cluster is-lg">
            <a href="/" class={[active === "courses" && "is-active"]}>Courses</a>
            <a e:if={session.isLoggedIn() && session.get("role") === "instructor"}
               href="/admin" class={[active === "admin" && "is-active"]}>Studio</a>
            <span e:if={session.isLoggedIn()} class="site-user">{session.get("userName")}</span>
            <button e:if={session.isLoggedIn()} class="is-ghost is-sm" onclick={() => onSignout()}>Sign out</button>
            <a e:else class="button is-sm" href="/signin">Sign in</a>
          </nav>
        </div>
      </header>

      <main class="app-main">
        <slot/>
      </main>

      <footer class="site-footer">
        <div class="site-footer-inner cluster">
          <span>lecturemint · watercolor lessons from the studio</span>
          <span>Paint a little every day.</span>
        </div>
      </footer>
    </div>
  </body>
</Layout>
